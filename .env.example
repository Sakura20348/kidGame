# ─── PragmaLab frontend (Vite) ────────────────────────────────────────────────
# Copy to .env and change what you need. Only VITE_* values are sent to the
# browser – never put passwords or API keys in this file.

# Where the API server lives, e.g. https://api.pragmalab.uz
# Leave empty when the app and the API are on the same site. In development
# (`npm run dev`) leave it empty: Vite forwards /api to API_PROXY_TARGET below.
VITE_API_URL=

# How often the app fetches changes (classes, lessons, messages…) from the server, in milliseconds.
VITE_SYNC_INTERVAL_MS=3000

# Development only: where `npm run dev` / `npm run preview` forward /api (the FastAPI server in server/).
API_PROXY_TARGET=http://127.0.0.1:8000
