# ─── PragmaLab API server ─────────────────────────────────────────────────────
# Copy to server/.env and fill in. Never share or commit .env (it holds secrets).

# Server
HOST=127.0.0.1
PORT=8000
# restart automatically when the code changes (turn off in production)
RELOAD=true
# where the app is opened from (comma-separated) – needed when the app and API are on different sites
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
# the app's address, used in emails
APP_URL=http://localhost:5173
# SQLite database file (relative to server/)
DATABASE_PATH=data/pragmalab.db

# Sign-in
# how long a sign-in stays valid, in days
SESSION_DAYS=30
# how long a teacher's email code works, in minutes
CODE_TTL_MINUTES=10

# Email – teachers get their sign-in code by email.
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASSWORD=<an "app password" from your Google account>, SMTP_FROM=PragmaLab <you@gmail.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Development: show the code on the Verify page instead of emailing it.
# Defaults to on when SMTP_HOST is empty. Always set to false in production.
SHOW_DEV_CODES=
